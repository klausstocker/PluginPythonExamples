   <plugins><![CDATA[[PI Plugin1 Python "{"datasetVariables":[{"name":"bestand","value":23,"unit":""},{"name":"kartongroesse","value":5,"unit":""}],"validation":"\"\"\"Die Ausgabe für die Werte aus dataset.py prüfen.\"\"\"\n\nimport unittest\n\nimport dataset\nfrom helpers import RedirectedStdout\n\n\ndef correct_implementation():\n    \"\"\"Vollständige Kartons durch wiederholtes Abziehen zählen.\"\"\"\n    bestand = int(dataset.bestand.value)\n    kartongroesse = int(dataset.kartongroesse.value)\n    kartons = 0\n    while bestand >= kartongroesse:\n        bestand = bestand - kartongroesse\n        kartons = kartons + 1\n    print(f'Kartons: {kartons}')\n    print(f'Rest: {bestand}')\n\n\nclass Checker(unittest.TestCase):  # do not rename; plugin checks expect this name\n    def test_output(self):\n        with RedirectedStdout() as student_out:\n            import answer\n        with RedirectedStdout() as expected_out:\n            correct_implementation()\n        self.assertEqual(str(student_out), str(expected_out))\n","indication":"# Packe mit einer while-Schleife vollständige Kartons und bestimme den Rest.\n","files":{},"evalConfig":{"runAtTest":true,"lintAtTest":true},"linterConfig":"--disable=all --enable=F,E,W","linterWeight":0.5,"cpuTime":5,"formatterConfig":""}"]]]></plugins>
