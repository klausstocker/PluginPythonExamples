   <plugins><![CDATA[[PI Plugin1 Python "{"datasetVariables":[{"name":"anzahl","value":4,"unit":""},{"name":"startdauer","value":2.0,"unit":""},{"name":"zuwachs","value":0.5,"unit":""}],"validation":"\"\"\"Die Ausgabe fuer die Werte aus dataset.py pruefen.\"\"\"\n\nimport unittest\n\nimport dataset\nfrom helpers import RedirectedStdout\n\n\ndef correct_implementation():\n    \"\"\"Die Dauer einer festgelegten Versuchsreihe aufsummieren.\"\"\"\n    anzahl = int(dataset.anzahl.value)\n    startdauer = float(dataset.startdauer.value)\n    zuwachs = float(dataset.zuwachs.value)\n    gesamtdauer = 0.0\n    dauer = startdauer\n    for versuch in range(anzahl):\n        gesamtdauer = gesamtdauer + dauer\n        dauer = dauer + zuwachs\n    print(f'Gesamtdauer: {gesamtdauer:.1f} s')\n\n\n\nclass Checker(unittest.TestCase):  # do not rename; plugin checks expect this name\n    def test_output(self):\n        with RedirectedStdout() as student_out:\n            import answer\n        with RedirectedStdout() as expected_out:\n            correct_implementation()\n        self.assertEqual(str(student_out), str(expected_out))\n","indication":"# Addiere die Versuchsdauern mit einer for-Schleife und gib die Gesamtdauer aus.\n","files":{},"evalConfig":{"runAtTest":true,"lintAtTest":true},"linterConfig":"--disable=all --enable=F,E,W","linterWeight":0.5,"cpuTime":5,"formatterConfig":""}"]]]></plugins>
