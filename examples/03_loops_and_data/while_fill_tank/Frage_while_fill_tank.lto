   <plugins><![CDATA[[PI Plugin1 Python "{"datasetVariables":[{"name":"fuellstand","value":2.0,"unit":""},{"name":"ziel","value":10.0,"unit":""},{"name":"zufluss","value":3.0,"unit":""}],"validation":"\"\"\"Die Ausgabe für die Werte aus dataset.py prüfen.\"\"\"\n\nimport unittest\n\nimport dataset\nfrom helpers import RedirectedStdout\n\n\ndef correct_implementation():\n    \"\"\"Einen Füllstand erhöhen, bis das Ziel erreicht ist.\"\"\"\n    fuellstand = float(dataset.fuellstand.value)\n    ziel = float(dataset.ziel.value)\n    zufluss = float(dataset.zufluss.value)\n    schritte = 0\n    while fuellstand < ziel:\n        fuellstand = fuellstand + zufluss\n        schritte = schritte + 1\n    print(f'Schritte: {schritte}')\n    print(f'Füllstand: {fuellstand:.1f} l')\n\n\nclass Checker(unittest.TestCase):  # do not rename; plugin checks expect this name\n    def test_output(self):\n        with RedirectedStdout() as student_out:\n            import answer\n        with RedirectedStdout() as expected_out:\n            correct_implementation()\n        self.assertEqual(str(student_out), str(expected_out))\n","indication":"# Erhöhe den Füllstand mit einer while-Schleife und zähle die Schritte.\n","files":{},"evalConfig":{"runAtTest":true,"lintAtTest":true},"linterConfig":"--disable=all --enable=F,E,W","linterWeight":0.5,"cpuTime":5,"formatterConfig":""}"]]]></plugins>
