   <plugins><![CDATA[[PI Plugin1 Python "{"datasetVariables":[{"name":"i","value":7,"unit":""}],"validation":"import unittest\nimport dataset\nimport answer\n\n\ndef correct(variante: int, a: bool, b: bool) -> bool:\n    \"\"\"Lies das Ausgangsbit in der Zeilenfolge 00, 01, 10, 11.\"\"\"\n    ausgangsbits = format(variante, \"04b\")\n    zeilenindex = 2 * int(a) + int(b)\n    return ausgangsbits[zeilenindex] == \"1\"\n\n\nclass Checker(unittest.TestCase):\n    def test_all_variants_and_inputs(self):\n        variante = int(dataset.i.value)\n        for a in [False, True]:\n            for b in [False, True]:\n                self.assertIs(answer.logische_funktion(a, b), correct(variante, a, b))\n","indication":"def logische_funktion(a: bool, b: bool) -> bool:\n    return a or b\n","files":{},"evalConfig":{"runAtTest":true,"lintAtTest":true},"linterConfig":"--disable=C0114,C0115,C0116","linterWeight":0.5,"cpuTime":5}"]]]></plugins>
